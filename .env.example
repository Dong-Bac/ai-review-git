# ── AI Provider Configuration ──────────────────────────────────
# Required: Your API key for the AI provider
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PROVIDER=deepseek

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_MAX_TOKENS=8192
# APP_NAME=ai-review
# APP_URL=https://github.com/your-org/ai-review

# ── Vector Memory Configuration ────────────────────────────────
# Controls retrieval of similar past reviews via ChromaDB
# VECTOR_MEMORY_ENABLED=true
# VECTOR_DB_PATH=.roo/memory/vector_db
# MEMORY_TOP_K=3
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Cache Configuration ────────────────────────────────────────
# Cache TTL in seconds (default: 300 = 5 minutes)
# AI_CACHE_TTL=300
